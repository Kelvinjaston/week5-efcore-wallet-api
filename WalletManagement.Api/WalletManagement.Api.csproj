<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>907974b8-00c2-4729-b761-e58e73a7df81</UserSecretsId>
  </PropertyGroup>

  <!-- Nested folders are separate projects or unrelated code: keep them out of the API build -->
  <ItemGroup>
    <Compile Remove="WalletManagement.Tests\**" />
    <Compile Remove="WalletManagement.Client\**" />
    <Compile Remove="WalletManagement.Api\**" />
    <Compile Remove="StudentGradeCalculator\**" />
    <Compile Remove="Week2-Utilities\**" />

    <Content Remove="WalletManagement.Tests\**" />
    <Content Remove="WalletManagement.Client\**" />
    <Content Remove="WalletManagement.Api\**" />

    <EmbeddedResource Remove="WalletManagement.Tests\**" />
    <EmbeddedResource Remove="WalletManagement.Client\**" />
    <EmbeddedResource Remove="WalletManagement.Api\**" />

    <None Remove="WalletManagement.Tests\**" />
    <None Remove="WalletManagement.Client\**" />
    <None Remove="WalletManagement.Api\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

</Project>